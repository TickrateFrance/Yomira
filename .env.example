# Copy to .env and set your backend URL. The app bundles .env as an asset and
# reads it at runtime; the in-app Settings override (stored on-device) wins.
BACKEND_BASE_URL=http://10.0.2.2:3000

# Optional second content source: Suwayomi-Server (runs Mihon extensions).
# Leave empty to disable. Point at your Suwayomi server (default port 4567).
SUWAYOMI_BASE=http://10.0.2.2:4567

# Suwayomi HTTP Basic Auth (match the server's BASIC_AUTH_*). Editable in-app
# under Settings -> Suwayomi login. Leave blank for no auth.
SUWAYOMI_USER=
SUWAYOMI_PASS=

# Discord Rich Presence (desktop only). App ID from the Discord Developer Portal.
DISCORD_APP_ID=
