# Copy to .env and fill. NEVER commit .env.

# Postgres connection (Prisma). With docker-compose the host is "db".
DATABASE_URL="postgresql://yomira:yomira@localhost:5432/yomira?schema=public"

# JWT signing secret. The app refuses to start while this is the example value.
# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# Token lifetime (zeit/ms style: 7d, 12h, 30m...)
JWT_EXPIRES_IN="7d"

# bcrypt cost factor (10-15)
BCRYPT_ROUNDS=12

# API listen port
PORT=3000

# Comma-separated allowed CORS origins, or * for any (dev only)
CORS_ORIGINS="*"

# Postgres credentials used by docker-compose for the db container
POSTGRES_USER=yomira
POSTGRES_PASSWORD=yomira
POSTGRES_DB=yomira
